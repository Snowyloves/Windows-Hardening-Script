# ----------------------------------------------------------------------------
# 6. Services, SMB, RDP, WinRM, optional features
# ----------------------------------------------------------------------------
function Invoke-Services {
    Section 'Services'
    $risky = 'TlntSvr','RemoteRegistry','SNMP','SNMPTRAP','SSDPSRV','upnphost','simptcp','RemoteAccess','lltdsvc',
             'p2psvc','p2pimsvc','PNRPsvc','PNRPAutoReg','Browser','icssvc','WMPNetworkSvc','NetTcpPortSharing',
             'RpcLocator','Fax','irmon','SharedAccess','ssh-agent','MSiSCSI'
    foreach ($s in $risky) { Disable-Svc $s }

    if (-not $KeepPrintSpooler) { Disable-Svc 'Spooler' } else { Log 'Print Spooler kept (requested)' 'WARN' }

    # Never auto-disabled: W3SVC, FTPSVC, SMTPSVC, sshd, database/web servers. Review them by hand.
    foreach ($s in 'W3SVC','FTPSVC','MSFTPSVC','SMTPSVC','sshd') {
        $svc = Get-Service -Name $s -ErrorAction SilentlyContinue
        if ($svc -and $svc.Status -eq 'Running') { Log "Service $s is running. If README does not need it, disable it manually." 'REVIEW' }
    }

    Section 'Windows Update'
    $au = 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate\AU'
    Set-Reg $au 'NoAutoUpdate' 0
    Set-Reg $au 'AUOptions' 4
    Set-Reg $au 'ScheduledInstallDay' 0
    Set-Reg $au 'ScheduledInstallTime' 3
    Remove-RegValue 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate' 'DisableWindowsUpdateAccess'
    Remove-RegValue 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate' 'WUServer'
    Remove-RegValue 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate' 'WUStatusServer'
    Remove-RegValue 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate\AU' 'UseWUServer'
    foreach ($s in 'wuauserv','UsoSvc','bits') {
        Try-Do "Enable $s" { Set-Service -Name $s -StartupType Manual -ErrorAction Stop; Start-Service -Name $s -ErrorAction SilentlyContinue }
    }
    Try-Do 'Trigger update scan' { Start-Process -FilePath "$env:windir\System32\UsoClient.exe" -ArgumentList 'StartScan' -WindowStyle Hidden }
}

function Invoke-NetworkServices {
    Section 'SMB / file sharing'
    Try-Do 'SMB server config' { Set-SmbServerConfiguration -EnableSMB1Protocol $false -EnableSMB2Protocol $true -RequireSecuritySignature $true -EnableSecuritySignature $true -Force -Confirm:$false }
    Try-Do 'SMB client config' { Set-SmbClientConfiguration -RequireSecuritySignature $true -EnableSecuritySignature $true -Force -Confirm:$false }
    if (-not $KeepFileSharing) {
        Get-SmbShare | Where-Object { $_.Special -eq $false -and $_.Name -notin 'print$' } | ForEach-Object {
            Log "Removing custom share '$($_.Name)' -> $($_.Path) (backup in shares-before.csv)" 'REVIEW'
            Try-Do "Remove share $($_.Name)" { Remove-SmbShare -Name $_.Name -Force -Confirm:$false }
        }
        Set-Reg 'HKLM:\SYSTEM\CurrentControlSet\Services\LanmanServer\Parameters' 'AutoShareWks' 0
        Set-Reg 'HKLM:\SYSTEM\CurrentControlSet\Services\LanmanServer\Parameters' 'AutoShareServer' 0
    } else { Log 'File sharing kept (requested); custom shares left in place, review their permissions.' 'WARN' }

    Section 'Remote Desktop'
    $tsr = 'HKLM:\SYSTEM\CurrentControlSet\Control\Terminal Server'
    $tsp = 'HKLM:\SOFTWARE\Policies\Microsoft\Windows NT\Terminal Services'
    if ($KeepRDP) {
        Set-Reg $tsr 'fDenyTSConnections' 0
        Set-Reg "$tsr\WinStations\RDP-Tcp" 'UserAuthentication' 1
        Set-Reg "$tsr\WinStations\RDP-Tcp" 'SecurityLayer' 2
        Set-Reg "$tsr\WinStations\RDP-Tcp" 'MinEncryptionLevel' 3
        Set-Reg $tsp 'UserAuthentication' 1
        Set-Reg $tsp 'SecurityLayer' 2
        Set-Reg $tsp 'MinEncryptionLevel' 3
        Set-Reg $tsp 'fPromptForPassword' 1
        Set-Reg $tsp 'MaxIdleTime' 900000
        Set-Reg $tsp 'MaxDisconnectionTime' 60000
        Log 'RDP kept with NLA + high encryption. Remove unauthorized users from Remote Desktop Users.' 'WARN'
    } else {
        Set-Reg $tsr 'fDenyTSConnections' 1
        Set-Reg $tsp 'fDenyTSConnections' 1
        Try-Do 'Disable RDP firewall rules' { Get-NetFirewallRule -DisplayGroup 'Remote Desktop' -ErrorAction SilentlyContinue | Disable-NetFirewallRule }
    }

    Section 'WinRM / PowerShell remoting'
    $wr = 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\WinRM'
    Set-Reg "$wr\Client"  'AllowBasic' 0
    Set-Reg "$wr\Client"  'AllowUnencryptedTraffic' 0
    Set-Reg "$wr\Client"  'AllowDigest' 0
    Set-Reg "$wr\Service" 'AllowBasic' 0
    Set-Reg "$wr\Service" 'AllowUnencryptedTraffic' 0
    Set-Reg "$wr\Service" 'DisableRunAs' 1
    if (-not $KeepWinRM) {
        Try-Do 'Disable WinRM' { Disable-PSRemoting -Force -ErrorAction SilentlyContinue; Stop-Service WinRM -Force -ErrorAction SilentlyContinue; Set-Service WinRM -StartupType Disabled }
    }

    Section 'Optional Windows features'
    foreach ($f in 'SMB1Protocol','SMB1Protocol-Client','SMB1Protocol-Server','MicrosoftWindowsPowerShellV2','MicrosoftWindowsPowerShellV2Root','TelnetClient','TFTP','TelnetServer','SimpleTCP') {
        try {
            $feat = Get-WindowsOptionalFeature -Online -FeatureName $f -ErrorAction Stop
            if ($feat.State -eq 'Enabled') { Try-Do "Disable feature $f" { Disable-WindowsOptionalFeature -Online -FeatureName $f -NoRestart -ErrorAction Stop | Out-Null } }
        } catch { }
    }
    if (Get-Command Get-WindowsFeature -ErrorAction SilentlyContinue) {   # Server SKUs
        foreach ($f in 'Telnet-Client','TFTP-Client','SNMP-Service','FS-SMB1','PowerShell-V2') {
            $x = Get-WindowsFeature -Name $f -ErrorAction SilentlyContinue
            if ($x -and $x.Installed) { Try-Do "Uninstall feature $f" { Uninstall-WindowsFeature -Name $f | Out-Null } }
        }
    }
}

# ----------------------------------------------------------------------------
# 7. Firewall
# ----------------------------------------------------------------------------
function Invoke-Firewall {
    Section 'Windows Defender Firewall'
    Try-Do 'Enable firewall on all profiles, block inbound by default, log drops' {
        Set-NetFirewallProfile -Profile Domain,Private,Public -Enabled True -DefaultInboundAction Block -DefaultOutboundAction Allow `
            -NotifyOnListen True -AllowUnicastResponseToMulticast False -LogBlocked True -LogAllowed False `
            -LogMaxSizeKilobytes 16384 -LogFileName '%systemroot%\system32\LogFiles\Firewall\pfirewall.log'
    }
    Try-Do 'Make sure firewall service is on' { Set-Service -Name mpssvc -StartupType Automatic; Start-Service mpssvc -ErrorAction SilentlyContinue }
    Remove-RegValue 'HKLM:\SOFTWARE\Policies\Microsoft\WindowsFirewall\DomainProfile' 'EnableFirewall'
    Remove-RegValue 'HKLM:\SOFTWARE\Policies\Microsoft\WindowsFirewall\StandardProfile' 'EnableFirewall'
    Remove-RegValue 'HKLM:\SOFTWARE\Policies\Microsoft\WindowsFirewall\PublicProfile' 'EnableFirewall'

    $groups = @('Remote Assistance','Windows Media Player Network Sharing Service','Network Discovery','Telnet Server','Windows Peer to Peer Collaboration Foundation','Wireless Portable Devices','mDNS','Cast to Device functionality')
    if (-not $KeepRDP)         { $groups += 'Remote Desktop' }
    if (-not $KeepWinRM)       { $groups += 'Windows Remote Management' }
    if (-not $KeepFileSharing) { $groups += 'File and Printer Sharing' }
    foreach ($g in $groups) {
        Try-Do "Disable firewall rule group: $g" {
            Get-NetFirewallRule -DisplayGroup $g -ErrorAction SilentlyContinue | Where-Object { $_.Enabled -eq 'True' } | Disable-NetFirewallRule
        }
    }
    Try-Do 'Block inbound Telnet/TFTP/NetBIOS-NS ports' {
        New-NetFirewallRule -DisplayName 'CP Block Telnet/TFTP inbound' -Direction Inbound -Action Block -Protocol TCP -LocalPort 23 -ErrorAction SilentlyContinue | Out-Null
        New-NetFirewallRule -DisplayName 'CP Block TFTP inbound' -Direction Inbound -Action Block -Protocol UDP -LocalPort 69 -ErrorAction SilentlyContinue | Out-Null
    }
    Log 'Listening-port report is in review-report.txt. Verify scored services still have inbound allow rules.' 'REVIEW'
}

# ----------------------------------------------------------------------------
# 8. Microsoft Defender
# ----------------------------------------------------------------------------
function Invoke-Defender {
    Section 'Microsoft Defender'
    $dp = 'HKLM:\SOFTWARE\Policies\Microsoft\Windows Defender'
    foreach ($n in 'DisableAntiSpyware','DisableAntiVirus','ServiceKeepAlive') { Remove-RegValue $dp $n }
    foreach ($n in 'DisableRealtimeMonitoring','DisableBehaviorMonitoring','DisableOnAccessProtection','DisableIOAVProtection','DisableScriptScanning') {
        Remove-RegValue "$dp\Real-Time Protection" $n
    }
    Try-Do 'Defender service on' { Set-Service -Name WinDefend -StartupType Automatic -ErrorAction SilentlyContinue; Start-Service WinDefend -ErrorAction SilentlyContinue }

    Try-Do 'Defender preferences' {
        Set-MpPreference -DisableRealtimeMonitoring $false -DisableBehaviorMonitoring $false -DisableIOAVProtection $false `
            -DisableScriptScanning $false -DisableArchiveScanning $false -DisableEmailScanning $false -DisableRemovableDriveScanning $false `
            -MAPSReporting Advanced -SubmitSamplesConsent SendSafeSamples -PUAProtection Enabled -CloudBlockLevel High `
            -CloudExtendedTimeout 50 -EnableNetworkProtection Enabled -EnableFileHashComputation $true -ErrorAction Stop
    }

    $mp = Get-MpPreference -ErrorAction SilentlyContinue
    if ($mp) {
        foreach ($p in @($mp.ExclusionPath))      { if ($p) { Try-Do "Remove exclusion path $p" { Remove-MpPreference -ExclusionPath $p } } }
        foreach ($e in @($mp.ExclusionExtension)) { if ($e) { Try-Do "Remove exclusion ext $e"  { Remove-MpPreference -ExclusionExtension $e } } }
        foreach ($x in @($mp.ExclusionProcess))   { if ($x) { Try-Do "Remove exclusion proc $x" { Remove-MpPreference -ExclusionProcess $x } } }
    }

    $asr = [ordered]@{
        'BE9BA2D9-53EA-4CDC-84E5-9B1EEEE46550' = 'Block executable content from email/webmail'
        'D4F940AB-401B-4EFC-AADC-AD5F3C50688A' = 'Block Office apps from creating child processes'
        '3B576869-A4EC-4529-8536-B80A7769E899' = 'Block Office apps from creating executable content'
        '75668C1F-73B5-4CF0-BB93-3ECF5CB7CC84' = 'Block Office apps from injecting code'
        'D3E037E1-3EB8-44C8-A917-57927947596D' = 'Block JS/VBS launching downloaded executables'
        '5BEB7EFE-FD9A-4556-801D-275E5FFC04CC' = 'Block execution of potentially obfuscated scripts'
        '92E97FA1-2EDF-4476-BDD6-9DD0B4DDDC7B' = 'Block Win32 API calls from Office macros'
        '9E6C4E1F-7D60-472F-BA1A-A39EF669E4B2' = 'Block credential stealing from LSASS'
        'B2B3F03D-6A65-4F7B-A9C7-1C7EF74A9BA4' = 'Block untrusted processes from USB'
        '56A863A9-875E-4185-98A7-B882C64B5CE5' = 'Block abuse of exploited vulnerable signed drivers'
    }
    foreach ($id in $asr.Keys) {
        Try-Do "ASR: $($asr[$id])" { Add-MpPreference -AttackSurfaceReductionRules_Ids $id -AttackSurfaceReductionRules_Actions Enabled -ErrorAction Stop }
    }

    Try-Do 'Update Defender signatures' { Update-MpSignature -ErrorAction Stop }
    Try-Do 'Start background quick scan' { Start-MpScan -ScanType QuickScan -AsJob | Out-Null }
}

# ----------------------------------------------------------------------------
# 9. TLS / cipher hardening
# ----------------------------------------------------------------------------
function Invoke-TLS {
    Section 'SCHANNEL protocols and ciphers'
    foreach ($p in 'SSL 2.0','SSL 3.0','TLS 1.0','TLS 1.1') {
        foreach ($side in 'Server','Client') {
            Try-Do "Disable $p ($side)" { Set-SchannelKey "Protocols\$p\$side" 0 1 }
        }
    }
    foreach ($side in 'Server','Client') {
        Try-Do "Enable TLS 1.2 ($side)" { Set-SchannelKey "Protocols\TLS 1.2\$side" 1 0 }
    }
    foreach ($c in 'NULL','DES 56/56','RC2 40/128','RC2 56/128','RC2 128/128','RC4 40/128','RC4 56/128','RC4 64/128','RC4 128/128','Triple DES 168') {
        Try-Do "Disable cipher $c" { Set-SchannelKey "Ciphers\$c" 0 }
    }
    Try-Do 'Disable MD5 hash' { Set-SchannelKey 'Hashes\MD5' 0 }
    foreach ($k in 'HKLM:\SOFTWARE\Microsoft\.NETFramework\v4.0.30319','HKLM:\SOFTWARE\WOW6432Node\Microsoft\.NETFramework\v4.0.30319') {
        Set-Reg $k 'SchUseStrongCrypto' 1
        Set-Reg $k 'SystemDefaultTlsVersions' 1
    }
}

