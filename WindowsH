<#
.SYNOPSIS
    Windows hardening + review script for CyberPatriot-style defensive competitions.

.DESCRIPTION
    1. Backs up current settings (registry, firewall, secedit, services, shares).
    2. Produces a REVIEW REPORT of things that need human judgment
       (users, groups, shares, ports, startup items, tasks, software, media files).
    3. Applies hardening: account/password policy, audit policy, security options,
       services, SMB, RDP/WinRM, firewall, Defender, Windows Update, TLS, logging.

    READ THE README FIRST. Anything the README says must stay (IIS, FTP, RDP, printing,
    file sharing, specific services) needs a -Keep* switch or -KeepServices entry,
    otherwise this script may disable it and cost you points.

.EXAMPLES
    # Look only, change nothing (do this first, also for forensics questions):
    .\Harden-Windows.ps1 -ReportOnly

    # Typical run:
    .\Harden-Windows.ps1 -AuthorizedUsers alice,bob,carol -AuthorizedAdmins alice

    # README says RDP + web server + printing are required:
    .\Harden-Windows.ps1 -AuthorizedUsers alice,bob -AuthorizedAdmins alice -KeepRDP -KeepPrintSpooler -KeepServices W3SVC,FTPSVC

    # Also set a new password for every other local user:
    .\Harden-Windows.ps1 -AuthorizedUsers alice,bob -AuthorizedAdmins alice -ResetPasswords

.NOTES
    Run from an elevated PowerShell:  powershell -ExecutionPolicy Bypass -File .\Harden-Windows.ps1
    Output goes to C:\CP-Hardening\<timestamp>\ (log, review report, backups).
#>
[CmdletBinding()]
param(
    [string[]]$AuthorizedUsers  = @(),   # every legit local user from the README (admins too)
    [string[]]$AuthorizedAdmins = @(),   # users who SHOULD be administrators
    [string[]]$KeepServices     = @(),   # service names to leave alone, e.g. W3SVC,FTPSVC,MSSQLSERVER
    [switch]$KeepRDP,
    [switch]$KeepFileSharing,
    [switch]$KeepPrintSpooler,
    [switch]$KeepWinRM,
    [switch]$ResetPasswords,
    [switch]$SkipTLS,                    # skip SCHANNEL protocol/cipher changes
    [switch]$ReportOnly                  # review report only, no changes
)

# ----------------------------------------------------------------------------
# Setup / helpers
# ----------------------------------------------------------------------------
$principal = [Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()
if (-not $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
    Write-Error 'Run this script from an elevated (Administrator) PowerShell.'
    exit 1
}

$ErrorActionPreference = 'Continue'
$Stamp      = Get-Date -Format 'yyyyMMdd-HHmmss'
$Dir        = Join-Path 'C:\CP-Hardening' $Stamp
New-Item -ItemType Directory -Path $Dir -Force | Out-Null
$LogFile    = Join-Path $Dir 'hardening.log'
$ReportFile = Join-Path $Dir 'review-report.txt'
$Me         = $env:USERNAME

function Log {
    param([string]$Msg, [string]$Level = 'INFO')
    $line = '[{0}] [{1}] {2}' -f (Get-Date -Format 'HH:mm:ss'), $Level, $Msg
    $color = switch ($Level) { 'WARN' {'Yellow'} 'ERR' {'Red'} 'REVIEW' {'Magenta'} 'OK' {'Green'} default {'Gray'} }
    Write-Host $line -ForegroundColor $color
    Add-Content -Path $LogFile -Value $line
}
function Section([string]$t) { Log "==== $t ====" 'OK' }

function Try-Do {
    param([string]$Desc, [scriptblock]$Action)
    try { & $Action; Log $Desc 'OK' }
    catch { Log "$Desc -> $($_.Exception.Message)" 'ERR' }
}

function Set-Reg {
    param([string]$Path, [string]$Name, $Value, [string]$Type = 'DWord')
    try {
        if (-not (Test-Path -LiteralPath $Path)) { New-Item -Path $Path -Force | Out-Null }
        New-ItemProperty -LiteralPath $Path -Name $Name -Value $Value -PropertyType $Type -Force | Out-Null
        Log "$Path\$Name = $Value"
    } catch { Log "FAILED $Path\$Name : $($_.Exception.Message)" 'ERR' }
}

function Remove-RegValue {
    param([string]$Path, [string]$Name)
    if (Test-Path -LiteralPath $Path) {
        if ($null -ne (Get-ItemProperty -LiteralPath $Path -Name $Name -ErrorAction SilentlyContinue)) {
            Remove-ItemProperty -LiteralPath $Path -Name $Name -Force -ErrorAction SilentlyContinue
            Log "Removed $Path\$Name"
        }
    }
}

function RptHeader([string]$t) {
    Add-Content -Path $ReportFile -Value "`r`n=== $t ==="
    Write-Host "`n=== $t ===" -ForegroundColor Cyan
}
function Rpt([string]$t) {
    Add-Content -Path $ReportFile -Value $t
    Write-Host $t -ForegroundColor Magenta
}
function RptTable($obj) {
    $s = ($obj | Format-Table -AutoSize -Wrap | Out-String -Width 220)
    Add-Content -Path $ReportFile -Value $s
    Write-Host $s
}

function Disable-Svc {
    param([string]$Name)
    $s = Get-Service -Name $Name -ErrorAction SilentlyContinue
    if (-not $s) { return }
    if ($KeepServices -contains $Name) { Log "Keeping service $Name (requested)" 'WARN'; return }
    Try-Do "Disable service $Name" {
        Stop-Service -Name $Name -Force -ErrorAction SilentlyContinue
        Set-Service -Name $Name -StartupType Disabled
    }
}

function Set-IniValue {
    param([string[]]$Lines, [string]$Section, [string]$Key, [string]$Value)
    $out = New-Object System.Collections.Generic.List[string]
    $inSec = $false; $done = $false
    foreach ($l in $Lines) {
        if ($l -match '^\s*\[(.+)\]\s*$') {
            if ($inSec -and -not $done) { $out.Add("$Key = $Value"); $done = $true }
            $inSec = ($Matches[1] -eq $Section)
            $out.Add($l); continue
        }
        if ($inSec -and $l -match ('^\s*' + [regex]::Escape($Key) + '\s*=')) {
            $out.Add("$Key = $Value"); $done = $true; continue
        }
        $out.Add($l)
    }
    if ($inSec -and -not $done) { $out.Add("$Key = $Value"); $done = $true }
    if (-not $done) { $out.Add("[$Section]"); $out.Add("$Key = $Value") }
    return , $out.ToArray()
}

function Set-SchannelKey {
    param([string]$SubPath, [int]$Enabled, [int]$DisabledByDefault = -1)
    $k = [Microsoft.Win32.Registry]::LocalMachine.CreateSubKey("SYSTEM\CurrentControlSet\Control\SecurityProviders\SCHANNEL\$SubPath")
    $k.SetValue('Enabled', $Enabled, [Microsoft.Win32.RegistryValueKind]::DWord)
    if ($DisabledByDefault -ge 0) { $k.SetValue('DisabledByDefault', $DisabledByDefault, [Microsoft.Win32.RegistryValueKind]::DWord) }
    $k.Close()
}

$AllAuthorized = @($AuthorizedUsers) + @($AuthorizedAdmins) | Sort-Object -Unique
function In-List { param([string]$Name, [string[]]$List) return ($List | Where-Object { $_ -ieq $Name }).Count -gt 0 }

# ----------------------------------------------------------------------------
# 0. Backups
# ----------------------------------------------------------------------------
function Invoke-Backup {
    Section 'Backups (restore point, registry, firewall, secedit, services, shares)'
    Try-Do 'System restore point' {
        Enable-ComputerRestore -Drive "$env:SystemDrive\" -ErrorAction SilentlyContinue
        Checkpoint-Computer -Description "CP-Hardening-$Stamp" -RestorePointType MODIFY_SETTINGS -ErrorAction Stop
    }
    foreach ($k in @(
        @{n='policies';  p='HKLM\SOFTWARE\Policies'},
        @{n='winpolicies'; p='HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies'},
        @{n='lsa';       p='HKLM\SYSTEM\CurrentControlSet\Control\Lsa'},
        @{n='lanman';    p='HKLM\SYSTEM\CurrentControlSet\Services\LanmanServer'},
        @{n='tcpip';     p='HKLM\SYSTEM\CurrentControlSet\Services\Tcpip'},
        @{n='schannel';  p='HKLM\SYSTEM\CurrentControlSet\Control\SecurityProviders\SCHANNEL'},
        @{n='terminal';  p='HKLM\SYSTEM\CurrentControlSet\Control\Terminal Server'}
    )) {
        reg export $k.p (Join-Path $Dir "$($k.n).reg") /y 2>&1 | Out-Null
    }
    secedit /export /cfg (Join-Path $Dir 'secpol-before.inf') /quiet
    netsh advfirewall export (Join-Path $Dir 'firewall-before.wfw') | Out-Null
    Get-CimInstance Win32_Service | Select-Object Name, StartMode, State, PathName |
        Export-Csv (Join-Path $Dir 'services-before.csv') -NoTypeInformation
    Try-Do 'Export SMB shares' { Get-SmbShare | Select-Object Name, Path, Description | Export-Csv (Join-Path $Dir 'shares-before.csv') -NoTypeInformation }
    auditpol /backup /file:(Join-Path $Dir 'auditpol-before.csv') | Out-Null
    Log "Backups saved in $Dir"
}

# ----------------------------------------------------------------------------
# 1. REVIEW REPORT (read-only, needs human judgment)
# ----------------------------------------------------------------------------
function Invoke-Review {
    Section 'Review report (read-only)'
    Set-Content -Path $ReportFile -Value "CyberPatriot review report  $(Get-Date)  host=$env:COMPUTERNAME  user=$Me"

    RptHeader 'Local users'
    RptTable (Get-LocalUser | Select-Object Name, Enabled, PasswordRequired, PasswordLastSet, LastLogon, PasswordExpires, Description)

    RptHeader 'Privileged group membership'
    foreach ($sid in 'S-1-5-32-544','S-1-5-32-547','S-1-5-32-551','S-1-5-32-555','S-1-5-32-580','S-1-5-32-558','S-1-5-32-578') {
        $g = Get-LocalGroup | Where-Object { $_.SID.Value -eq $sid }
        if ($g) {
            Add-Content $ReportFile "-- $($g.Name)"
            Write-Host "-- $($g.Name)" -ForegroundColor Cyan
            $m = Get-LocalGroupMember -Group $g.Name -ErrorAction SilentlyContinue
            if ($m) { RptTable ($m | Select-Object Name, ObjectClass, PrincipalSource) } else { Rpt '   (empty)' }
        }
    }

    if ($AllAuthorized.Count -gt 0) {
        RptHeader 'Users NOT in your authorized list'
        Get-LocalUser | Where-Object { -not (In-List $_.Name $AllAuthorized) -and $_.Name -notin 'Administrator','Guest','DefaultAccount','WDAGUtilityAccount' } |
            ForEach-Object { Rpt "UNAUTHORIZED? $($_.Name) (Enabled=$($_.Enabled))" }
        RptHeader 'Authorized users that do not exist locally'
        $AllAuthorized | Where-Object { -not (Get-LocalUser -Name $_ -ErrorAction SilentlyContinue) } | ForEach-Object { Rpt "MISSING: $_ (README may want you to create them)" }
    }

    RptHeader 'Network shares'
    RptTable (Get-SmbShare | Select-Object Name, Path, Description)

    RptHeader 'Listening TCP ports and owning process'
    RptTable (Get-NetTCPConnection -State Listen -ErrorAction SilentlyContinue |
        Select-Object LocalAddress, LocalPort,
            @{n='Process'; e={ (Get-Process -Id $_.OwningProcess -ErrorAction SilentlyContinue).Name }},
            @{n='Path';    e={ (Get-Process -Id $_.OwningProcess -ErrorAction SilentlyContinue).Path }} |
        Sort-Object LocalPort)

    RptHeader 'Non-Microsoft / non-Windows services'
    RptTable (Get-CimInstance Win32_Service |
        Where-Object { $_.PathName -and $_.PathName -notmatch '(?i)\\Windows\\|svchost|Microsoft|Windows Defender' } |
        Select-Object Name, State, StartMode, PathName)

    RptHeader 'Unquoted service paths (privilege-escalation risk)'
    RptTable (Get-CimInstance Win32_Service |
        Where-Object { $_.PathName -and $_.PathName -notmatch '^"' -and $_.PathName -match '^[A-Za-z]:\\[^"]*? [^"]*?\.exe' -and $_.PathName -notmatch '^[A-Za-z]:\\Windows\\' } |
        Select-Object Name, PathName)

    RptHeader 'Services that commonly matter (state)'
    $watch = 'W3SVC','FTPSVC','MSFTPSVC','SMTPSVC','sshd','TermService','WinRM','Spooler','LanmanServer','RemoteRegistry','TlntSvr','SNMP','MSSQLSERVER','MySQL','Apache2.4','nginx','vncserver','TeamViewer','AnyDesk'
    RptTable (Get-Service -Name $watch -ErrorAction SilentlyContinue | Select-Object Name, Status, StartType)

    RptHeader 'Startup entries (Run keys)'
    foreach ($p in 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Run','HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\RunOnce',
                   'HKLM:\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Run','HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\Run','HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\RunOnce') {
        if (Test-Path $p) {
            Add-Content $ReportFile "-- $p"
            (Get-ItemProperty $p).PSObject.Properties | Where-Object { $_.Name -notlike 'PS*' } | ForEach-Object { Rpt "   $($_.Name) = $($_.Value)" }
        }
    }
    foreach ($f in "$env:ProgramData\Microsoft\Windows\Start Menu\Programs\Startup", "$env:APPDATA\Microsoft\Windows\Start Menu\Programs\Startup") {
        Get-ChildItem $f -Force -ErrorAction SilentlyContinue | ForEach-Object { Rpt "STARTUP FOLDER: $($_.FullName)" }
    }

    RptHeader 'Winlogon / IFEO backdoor checks'
    $wl = Get-ItemProperty 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon' -ErrorAction SilentlyContinue
    Rpt "Shell    = $($wl.Shell)   (expected explorer.exe)"
    Rpt "Userinit = $($wl.Userinit) (expected C:\Windows\system32\userinit.exe,)"
    if ($wl.AutoAdminLogon -eq '1') { Rpt "AUTOLOGON ENABLED for $($wl.DefaultUserName)" }
    if ($wl.DefaultPassword)        { Rpt 'DefaultPassword is stored in cleartext in Winlogon key!' }
    Get-ChildItem 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Image File Execution Options' -ErrorAction SilentlyContinue |
        ForEach-Object { $d = (Get-ItemProperty $_.PSPath -ErrorAction SilentlyContinue).Debugger; if ($d) { Rpt "IFEO Debugger: $($_.PSChildName) -> $d" } }

    RptHeader 'Scheduled tasks (non-Microsoft)'
    RptTable (Get-ScheduledTask -ErrorAction SilentlyContinue | Where-Object { $_.TaskPath -notlike '\Microsoft\*' } |
        Select-Object TaskName, TaskPath, State, @{n='Run'; e={ ($_.Actions | ForEach-Object { "$($_.Execute) $($_.Arguments)" }) -join '; ' }})

    RptHeader 'Hosts file (non-comment lines)'
    Get-Content "$env:windir\System32\drivers\etc\hosts" | Where-Object { $_ -notmatch '^\s*#' -and $_.Trim() } | ForEach-Object { Rpt "   $_" }

    RptHeader 'Installed software (suspicious names flagged)'
    $bad = 'wireshark|nmap|zenmap|john|hashcat|cain|netcat|ncat|keylog|utorrent|bittorrent|qbittorrent|limewire|vuze|frostwire|tightvnc|ultravnc|realvnc|teamviewer|anydesk|logmein|ophcrack|metasploit|burp|aircrack|angry ip|hydra|pwdump|mimikatz|cheat engine|crack|keygen|steam|minecraft|discord|pidgin|gaming'
    $apps = Get-ItemProperty 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\*','HKLM:\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*','HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\*' -ErrorAction SilentlyContinue |
        Where-Object DisplayName | Sort-Object DisplayName
    foreach ($a in $apps) {
        $flag = if ($a.DisplayName -match $bad) { '  <== REVIEW' } else { '' }
        Rpt ("   {0} {1}{2}" -f $a.DisplayName, $a.DisplayVersion, $flag)
    }

    RptHeader 'Prohibited-media / sensitive-looking files'
    $roots = @('C:\Users') + (Get-ChildItem 'C:\' -Directory -Force -ErrorAction SilentlyContinue |
        Where-Object { $_.Name -notin 'Windows','Program Files','Program Files (x86)','$Recycle.Bin','System Volume Information','PerfLogs','ProgramData','Users','Recovery','CP-Hardening' } |
        ForEach-Object { $_.FullName })
    $media = '*.mp3','*.mp4','*.m4a','*.wav','*.flac','*.ogg','*.wma','*.avi','*.mkv','*.mov','*.wmv','*.mpg','*.mpeg','*.torrent'
    foreach ($r in $roots) {
        Get-ChildItem -Path $r -Include $media -Recurse -Force -File -ErrorAction SilentlyContinue |
            Where-Object { $_.FullName -notmatch '\\AppData\\Local\\(Microsoft|Packages)|\\Windows\\' } |
            ForEach-Object { Rpt "MEDIA: $($_.FullName)" }
        Get-ChildItem -Path $r -Include '*password*','*passwd*','*creds*','*credential*','*secret*','*.kdbx','*.pwd' -Recurse -Force -File -ErrorAction SilentlyContinue |
            ForEach-Object { Rpt "SENSITIVE?: $($_.FullName)" }
    }

    RptHeader 'Defender exclusions (attackers love these)'
    $mp = Get-MpPreference -ErrorAction SilentlyContinue
    if ($mp) {
        $mp.ExclusionPath      | ForEach-Object { Rpt "Excl path: $_" }
        $mp.ExclusionExtension | ForEach-Object { Rpt "Excl ext: $_" }
        $mp.ExclusionProcess   | ForEach-Object { Rpt "Excl proc: $_" }
    }

    Log "Review report written to $ReportFile" 'REVIEW'
}

# ----------------------------------------------------------------------------
# 2. Accounts
# ----------------------------------------------------------------------------
function Invoke-Accounts {
    Section 'User accounts'
    $builtin = 'DefaultAccount','WDAGUtilityAccount'

    Get-LocalUser | ForEach-Object {
        $u = $_
        $isBuiltinAdmin = $u.SID.Value -like '*-500'
        if ($u.Name -eq 'Guest' -or $u.SID.Value -like '*-501') {
            if ($u.Enabled) { Try-Do 'Disable Guest account' { Disable-LocalUser -Name $u.Name } }
            return
        }
        if ($builtin -contains $u.Name) { if ($u.Enabled) { Try-Do "Disable $($u.Name)" { Disable-LocalUser -Name $u.Name } }; return }
        if ($isBuiltinAdmin) {
            if ($u.Enabled -and $u.Name -ne $Me) { Try-Do 'Disable built-in Administrator' { Disable-LocalUser -Name $u.Name } }
            return
        }
        if ($AllAuthorized.Count -gt 0 -and -not (In-List $u.Name $AllAuthorized)) {
            if ($u.Enabled) {
                Log "Unauthorized user '$($u.Name)' DISABLED (not deleted). Delete manually after confirming README." 'REVIEW'
                Try-Do "Disable $($u.Name)" { Disable-LocalUser -Name $u.Name }
            }
            return
        }
        if ($u.Enabled) {
            Try-Do "Password must expire / be required: $($u.Name)" {
                Set-LocalUser -Name $u.Name -PasswordNeverExpires $false
                net user $u.Name /passwordreq:yes | Out-Null
            }
        }
    }

    # Administrators group
    $adminGrp = (Get-LocalGroup | Where-Object { $_.SID.Value -eq 'S-1-5-32-544' }).Name
    if ($AuthorizedAdmins.Count -gt 0) {
        Get-LocalGroupMember -Group $adminGrp -ErrorAction SilentlyContinue | Where-Object { $_.ObjectClass -eq 'User' -and $_.PrincipalSource -eq 'Local' } | ForEach-Object {
            $n = $_.Name.Split('\')[-1]
            if ($_.SID.Value -like '*-500' -or $n -eq $Me) { return }
            if (-not (In-List $n $AuthorizedAdmins)) {
                Try-Do "Remove $n from Administrators" { Remove-LocalGroupMember -Group $adminGrp -Member $_.Name }
            }
        }
        foreach ($a in $AuthorizedAdmins) {
            if ((Get-LocalUser -Name $a -ErrorAction SilentlyContinue) -and -not (Get-LocalGroupMember -Group $adminGrp -ErrorAction SilentlyContinue | Where-Object { $_.Name.Split('\')[-1] -ieq $a })) {
                Try-Do "Add $a to Administrators" { Add-LocalGroupMember -Group $adminGrp -Member $a }
            }
        }
    } else {
        Log 'No -AuthorizedAdmins given: Administrators group left unchanged (see report).' 'WARN'
    }

    # Prune risky groups of unauthorized users
    foreach ($sid in 'S-1-5-32-551','S-1-5-32-547','S-1-5-32-555') {   # Backup Ops, Power Users, Remote Desktop Users
        $g = Get-LocalGroup | Where-Object { $_.SID.Value -eq $sid }
        if ($g -and $AllAuthorized.Count -gt 0) {
            Get-LocalGroupMember -Group $g.Name -ErrorAction SilentlyContinue | Where-Object { $_.ObjectClass -eq 'User' } | ForEach-Object {
                if (-not (In-List $_.Name.Split('\')[-1] $AllAuthorized)) {
                    Try-Do "Remove $($_.Name) from $($g.Name)" { Remove-LocalGroupMember -Group $g.Name -Member $_.Name }
                }
            }
        }
    }

    if ($ResetPasswords) {
        $pw = Read-Host 'NEW password for all OTHER enabled local users (14+ chars, upper/lower/digit/symbol)' -AsSecureString
        $bstr = [Runtime.InteropServices.Marshal]::SecureStringToBSTR($pw)
        $plain = [Runtime.InteropServices.Marshal]::PtrToStringBSTR($bstr)
        [Runtime.InteropServices.Marshal]::ZeroFreeBSTR($bstr)
        if ($plain.Length -lt 14) {
            Log 'Password too short; skipping password reset.' 'ERR'
        } else {
            Get-LocalUser | Where-Object { $_.Enabled -and $_.Name -ne $Me } | ForEach-Object {
                Try-Do "Reset password: $($_.Name)" { Set-LocalUser -Name $_.Name -Password $pw }
            }
        }
        $plain = $null
    }
    Log "Reminder: change YOUR OWN password ($Me) manually unless the README says otherwise." 'REVIEW'
}

# ----------------------------------------------------------------------------
# 3. Local security policy (password, lockout, user rights) via secedit
# ----------------------------------------------------------------------------
function Invoke-SecPol {
    Section 'Password / lockout policy and user rights (secedit)'
    $cfg = Join-Path $env:TEMP 'cp-secpol.inf'
    $db  = Join-Path $env:TEMP 'cp-secpol.sdb'
    secedit /export /cfg $cfg /areas SECURITYPOLICY USER_RIGHTS /quiet
    $lines = Get-Content $cfg

    $sys = [ordered]@{
        MinimumPasswordAge           = 1
        MaximumPasswordAge           = 60
        MinimumPasswordLength        = 14
        PasswordComplexity           = 1
        PasswordHistorySize          = 24
        LockoutBadCount              = 5
        ResetLockoutCount            = 30
        LockoutDuration              = 30
        RequireLogonToChangePassword = 0
        ForceLogoffWhenHourExpire    = 1
        ClearTextPassword            = 0
        LSAAnonymousNameLookup       = 0
    }
    foreach ($k in $sys.Keys) { $lines = Set-IniValue -Lines $lines -Section 'System Access' -Key $k -Value $sys[$k] }

    $rights = [ordered]@{
        SeDenyNetworkLogonRight           = 'Guest,*S-1-5-32-546'
        SeDenyRemoteInteractiveLogonRight = 'Guest,*S-1-5-32-546'
        SeNetworkLogonRight               = '*S-1-5-32-544,*S-1-5-11'
        SeTrustedCredManAccessPrivilege   = ''
        SeTcbPrivilege                    = ''
        SeCreateTokenPrivilege            = ''
        SeLockMemoryPrivilege             = ''
        SeEnableDelegationPrivilege       = ''
        SeDebugPrivilege                  = '*S-1-5-32-544'
        SeRemoteShutdownPrivilege         = '*S-1-5-32-544'
    }
    foreach ($k in $rights.Keys) { $lines = Set-IniValue -Lines $lines -Section 'Privilege Rights' -Key $k -Value $rights[$k] }

    $lines | Set-Content -Path $cfg -Encoding Unicode
    Try-Do 'Apply secedit policy' {
        secedit /configure /db $db /cfg $cfg /areas SECURITYPOLICY USER_RIGHTS /quiet
        if ($LASTEXITCODE -gt 1) { throw "secedit exit code $LASTEXITCODE (see %windir%\security\logs\scesrv.log)" }
    }
    Remove-Item $cfg, $db -Force -ErrorAction SilentlyContinue
}

# ----------------------------------------------------------------------------
# 4. Audit policy + logging
# ----------------------------------------------------------------------------
function Invoke-Auditing {
    Section 'Audit policy and event logging'
    Try-Do 'Audit all categories success+failure' { auditpol /set '/category:*' /success:enable /failure:enable | Out-Null }
    Set-Reg 'HKLM:\SYSTEM\CurrentControlSet\Control\Lsa' 'SCENoApplyLegacyAuditPolicy' 1
    Set-Reg 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System\Audit' 'ProcessCreationIncludeCmdLine_Enabled' 1

    foreach ($l in @(@('Security', 196608000), @('System', 67108864), @('Application', 67108864))) {
        Try-Do "Event log size: $($l[0])" { wevtutil sl $l[0] /ms:$($l[1]) /rt:false }
    }

    $ps = 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\PowerShell'
    Set-Reg "$ps\ScriptBlockLogging" 'EnableScriptBlockLogging' 1
    Set-Reg "$ps\ModuleLogging" 'EnableModuleLogging' 1
    Set-Reg "$ps\ModuleLogging\ModuleNames" '*' '*' 'String'
    Set-Reg "$ps\Transcription" 'EnableTranscripting' 1
    Set-Reg "$ps\Transcription" 'OutputDirectory' 'C:\PSTranscripts' 'String'
    Set-Reg "$ps\Transcription" 'EnableInvocationHeader' 1
}

# ----------------------------------------------------------------------------
# 5. Security options / registry hardening
# ----------------------------------------------------------------------------
function Invoke-RegistryHardening {
    Section 'Security options (registry)'
    $lsa = 'HKLM:\SYSTEM\CurrentControlSet\Control\Lsa'
    Set-Reg $lsa 'LmCompatibilityLevel' 5
    Set-Reg $lsa 'NoLMHash' 1
    Set-Reg $lsa 'RestrictAnonymous' 1
    Set-Reg $lsa 'RestrictAnonymousSAM' 1
    Set-Reg $lsa 'EveryoneIncludesAnonymous' 0
    Set-Reg $lsa 'LimitBlankPasswordUse' 1
    Set-Reg $lsa 'DisableDomainCreds' 1
    Set-Reg $lsa 'ForceGuest' 0
    Set-Reg $lsa 'RunAsPPL' 1
    Set-Reg "$lsa\MSV1_0" 'NTLMMinClientSec' 537395200
    Set-Reg "$lsa\MSV1_0" 'NTLMMinServerSec' 537395200
    Set-Reg "$lsa\MSV1_0" 'allownullsessionfallback' 0
    Set-Reg 'HKLM:\SYSTEM\CurrentControlSet\Control\SecurityProviders\WDigest' 'UseLogonCredential' 0
    Set-Reg 'HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager' 'ProtectionMode' 1
    Set-Reg 'HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager' 'SafeDllSearchMode' 1
    Set-Reg 'HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager\kernel' 'DisableExceptionChainValidation' 0

    # UAC / interactive logon
    $sys = 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System'
    Set-Reg $sys 'EnableLUA' 1
